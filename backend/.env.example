# ==============================================================================
# AI Student Support Assistant - Backend Environment Configuration
# ==============================================================================

# Gemini API Key (Required for AI agent response generation and embeddings)
# In Google AI Studio, this is automatically provided from secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Server network configurations
HOST="0.0.0.0"
PORT=8001

# RAG & Embedding settings
EMBEDDING_MODEL="gemini-embedding-2-preview"
LLM_MODEL="gemini-3.8-flash"
